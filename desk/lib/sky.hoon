|%
::
+|  %types
::
++  foobar
  |=  =term
  ?+  term  !!
    %txt  wain
  ==
::
+|  %parsers
::
++  cut-path
  |=  [=cord sep=@t]
  ^-  path
  %+  murn
    p:(need q:((cook |=(a=(list wain) a) (more (jest sep) (star ;~(less (jest sep) next)))) [[1 1] (trip cord)]))
  |=  =wain
  ^-  (unit term)
  ?:  =('' wain)
    ~
  %-  some
  (term (crip wain))
--
